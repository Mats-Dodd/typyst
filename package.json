{
  "name": "haptic",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev-web": "turbo run dev --filter=web --filter=homepage",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "prepare": "husky",
    "migrate:generate": "turbo run migrate:generate",
    "migrate:push": "turbo run migrate:push"
  },
  "devDependencies": {
    "@haptic/eslint-config": "workspace:*",
    "dotenv-cli": "^8.0.0",
    "eslint": "^8.56.0",
    "husky": "^9.0.10",
    "lint-staged": "^15.2.1",
    "prettier": "^3.1.1",
    "prettier-plugin-svelte": "^3.1.2",
    "turbo": "latest"
  },
  "packageManager": "pnpm@8.9.0",
  "lint-staged": {
    "*.{svelte,js,ts}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
